   "paths": {
      "/qubetics/blocks/get-all-blocks": {
         "get": {
            "tags": ["Explorer"],
            "summary": "Get list of all blocks",
            "parameters": [
               {
                  "in": "query",
                  "name": "page",
                  "schema": {
                     "type": "string"
                  }
               },
               {
                  "in": "query",
                  "name": "limit",
                  "schema": {
                     "type": "string"
                  }
               },
               {
                  "in": "query",
                  "name": "order",
                  "schema": {
                     "type": "string"
                  }
               }
            ],
            "responses": {
               "200": {
                  "description": "Block Fetched Successfully",
                  "content": {
                     "application/json": {
                        "schema": {
                           "type": "object",
                           "properties": {
                              "message": {
                                 "type": "string"
                              },
                              "data": {
                                 "type": "object",
                                 "$ref": "#/components/schemas/blocks"
                              }
                           }
                        }
                     }
                  }
               },
               "400": {
                  "description": "Oops! Something went wrong. Please try again."
               }
            }
